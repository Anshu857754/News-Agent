# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your real values.
# The .env file is git-ignored and must never be committed.
#
#   cp .env.example .env        # Windows: copy .env.example .env
# ---------------------------------------------------------------------------

# === REQUIRED ==============================================================
# Your OpenRouter key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model used for every LLM call. One key gives access to all of them.
# Leave empty to use the default (google/gemini-2.5-flash).
OPENROUTER_MODEL=google/gemini-2.5-flash


# === OPTIONAL: Apify =======================================================
# Used by the news collection stage. Apify gives ONE personal token for your
# whole account - there is no per-actor key. Get it at:
#   Apify Console -> Settings -> Integrations -> Personal API tokens
APIFY_API_TOKEN=


# === TREND DISCOVERY =======================================================
# Only trends scoring at or above this (0-100) reach the final output.
TREND_RELEVANCE_THRESHOLD=70

# Defaults used when a request does not say. Region is an ISO country code
# (IN, US, GB ...) or GLOBAL.
# TREND_DEFAULT_REGION=IN
# TREND_DEFAULT_LIMIT=20

# Google Trends has no worldwide feed, so GLOBAL is composed from these.
# TREND_GLOBAL_REGIONS=US,GB,IN

# In-memory cache for collected trends. 0 disables caching.
# TREND_CACHE_TTL_SECONDS=900
# TREND_PROVIDER_TIMEOUT_SECONDS=15
# Topics per LLM request. Lower it only if a model truncates replies.
# TREND_AI_BATCH_SIZE=25


# === OPTIONAL: tuning ======================================================
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_SECONDS=30
# OPENROUTER_MAX_RETRIES=2
# OPENROUTER_TEMPERATURE=0.3

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
